<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="18" styleClass="workspace"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group100.wms.ui.admin.AuditLogController">
    <padding><Insets top="28" right="34" bottom="30" left="34"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="ADMIN" styleClass="module-kicker"/>
            <Label text="Audit Log" styleClass="module-title"/>
            <Label text="Tracked user actions and table-level changes for system accountability." styleClass="module-subtitle"/>
        </VBox>
        <Label text="System event trail" styleClass="module-chip"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-panel">
        <VBox styleClass="field-group">
            <Label text="User ID or table name" styleClass="field-label"/>
            <TextField fx:id="filterField" prefWidth="260" promptText="e.g. 1 or users"/>
        </VBox>
        <Button text="Filter" onAction="#handleFilter" styleClass="btn-primary"/>
        <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-outline"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="" styleClass="status-text"/>
    </HBox>

    <VBox styleClass="table-shell" VBox.vgrow="ALWAYS">
        <HBox styleClass="table-titlebar">
            <VBox spacing="2">
                <Label text="System Event Trail" styleClass="table-title"/>
                <Label text="Action, table, record id, detail message and timestamp." styleClass="table-caption"/>
            </VBox>
        </HBox>
        <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId"        text="ID"        prefWidth="60"/>
                <TableColumn fx:id="colUserId"    text="User ID"   prefWidth="80"/>
                <TableColumn fx:id="colAction"    text="Action"    prefWidth="130"/>
                <TableColumn fx:id="colTable"     text="Table"     prefWidth="130"/>
                <TableColumn fx:id="colRecordId"  text="Record ID" prefWidth="90"/>
                <TableColumn fx:id="colDetails"   text="Details"   prefWidth="310"/>
                <TableColumn fx:id="colTimestamp" text="Timestamp" prefWidth="190"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
