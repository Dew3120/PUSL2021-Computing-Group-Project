<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="18" styleClass="workspace"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group100.wms.ui.inbound.PurchaseOrderListController">
    <padding><Insets top="28" right="34" bottom="30" left="34"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="INBOUND" styleClass="module-kicker"/>
            <Label text="Purchase Orders" styleClass="module-title"/>
            <Label text="Supplier orders, expected delivery dates and receiving status." styleClass="module-subtitle"/>
        </VBox>
        <Label text="Procurement pipeline" styleClass="module-chip"/>
    </HBox>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="TOTAL POS" styleClass="metric-label"/>
            <Label fx:id="lblTotalPo" text="--" styleClass="metric-value"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="RECEIVED" styleClass="metric-label"/>
            <Label fx:id="lblReceived" text="--" styleClass="metric-value-success"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="PENDING" styleClass="metric-label"/>
            <Label fx:id="lblPending" text="--" styleClass="metric-value-warning"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="CANCELLED" styleClass="metric-label"/>
            <Label fx:id="lblCancelled" text="--" styleClass="metric-value-danger"/>
        </VBox>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-panel">
        <VBox styleClass="field-group">
            <Label text="Status" styleClass="field-label"/>
            <ComboBox fx:id="cmbStatus" prefWidth="190"/>
        </VBox>
        <VBox styleClass="field-group">
            <Label text="Supplier" styleClass="field-label"/>
            <ComboBox fx:id="cmbSupplier" prefWidth="250"/>
        </VBox>
        <Button text="Filter" onAction="#handleFilter" styleClass="btn-primary"/>
        <Button text="Reset" onAction="#handleReset" styleClass="btn-outline"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Export PDF" onAction="#handleExportPdf" styleClass="btn-primary"/>
        <Button text="Export Excel" onAction="#handleExportExcel" styleClass="btn-success"/>
    </HBox>

    <VBox styleClass="table-shell" VBox.vgrow="ALWAYS">
        <HBox styleClass="table-titlebar">
            <VBox spacing="2">
                <Label text="Order Register" styleClass="table-title"/>
                <Label text="Supplier, warehouse, order date, expected date and status." styleClass="table-caption"/>
            </VBox>
        </HBox>
        <TableView fx:id="poTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colPoId" text="PO #" prefWidth="70"/>
                <TableColumn fx:id="colSupplier" text="Supplier" prefWidth="230"/>
                <TableColumn fx:id="colWarehouse" text="Warehouse" prefWidth="170"/>
                <TableColumn fx:id="colOrderDate" text="Order Date" prefWidth="120"/>
                <TableColumn fx:id="colExpDate" text="Expected" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="160"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
