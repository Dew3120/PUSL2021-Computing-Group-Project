<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group100.wms.ui.inbound.GrnListController"
      spacing="12">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Goods Received Notes" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
    <Button text="Refresh" onAction="#handleRefresh" prefWidth="100"/>
    <TableView fx:id="grnTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"           text="ID"           prefWidth="60"/>
            <TableColumn fx:id="colGrnNumber"    text="GRN Number"   prefWidth="180"/>
            <TableColumn fx:id="colStatus"       text="Status"       prefWidth="120"/>
            <TableColumn fx:id="colReceivedDate" text="Received Date" prefWidth="150"/>
        </columns>
    </TableView>
    <Label fx:id="statusLabel" text=""/>
</VBox>