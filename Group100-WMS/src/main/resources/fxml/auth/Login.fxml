<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.group100.wms.ui.auth.LoginController"
           prefWidth="1120" prefHeight="720"
           styleClass="login-root">
    <Pane styleClass="login-scrim"/>
    <HBox alignment="CENTER" maxWidth="980" maxHeight="560" styleClass="login-shell">
        <VBox spacing="18" HBox.hgrow="ALWAYS" styleClass="login-brand-panel">
            <ImageView fitWidth="185" fitHeight="76" preserveRatio="true">
                <image><Image url="@/images/logo2.jpg"/></image>
            </ImageView>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Group100 WMS" styleClass="login-brand-title"/>
            <Label text="Inventory, inbound, outbound, attendance, payroll and forecasting in one operational workspace."
                   styleClass="login-brand-copy" wrapText="true"/>
            <HBox spacing="8">
                <Label text="MySQL" styleClass="module-chip"/>
                <Label text="JavaFX" styleClass="module-chip"/>
                <Label text="Live Reports" styleClass="module-chip"/>
            </HBox>
        </VBox>

        <VBox spacing="16" prefWidth="410" styleClass="login-card">
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Sign in" styleClass="login-title"/>
            <Label text="Use your WMS account to continue" styleClass="login-subtitle"/>

            <VBox spacing="6">
                <Label text="USERNAME" styleClass="login-label"/>
                <TextField fx:id="usernameField" promptText="Enter your username" styleClass="login-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="PASSWORD" styleClass="login-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="login-field"/>
            </VBox>

            <Label fx:id="errorLabel" text="" styleClass="error-label" wrapText="true"/>
            <Button text="SIGN IN" onAction="#handleLogin" maxWidth="Infinity" styleClass="login-button"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</StackPane>
