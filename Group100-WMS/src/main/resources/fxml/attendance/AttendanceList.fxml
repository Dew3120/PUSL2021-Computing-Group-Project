<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="18" styleClass="workspace"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group100.wms.ui.attendance.AttendanceListController">
    <padding><Insets top="28" right="34" bottom="30" left="34"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="ATTENDANCE" styleClass="module-kicker"/>
            <Label text="Attendance Records" styleClass="module-title"/>
            <Label text="Daily worker clock records, status filters and supervisor submissions." styleClass="module-subtitle"/>
        </VBox>
        <Button text="Refresh" styleClass="btn-primary" onAction="#handleReset"/>
        <Button text="Export PDF" styleClass="btn-primary" onAction="#handleExportPdf"/>
        <Button text="Export Excel" styleClass="btn-success" onAction="#handleExportExcel"/>
    </HBox>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="TOTAL RECORDS" styleClass="metric-label"/>
            <Label fx:id="lblTotal" text="0" styleClass="metric-value"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="PRESENT" styleClass="metric-label"/>
            <Label fx:id="lblPresent" text="0" styleClass="metric-value-success"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="ABSENT" styleClass="metric-label"/>
            <Label fx:id="lblAbsent" text="0" styleClass="metric-value-danger"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="HALF DAY" styleClass="metric-label"/>
            <Label fx:id="lblHalf" text="0" styleClass="metric-value-warning"/>
        </VBox>
    </HBox>

    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Attendance Register">
            <VBox spacing="14">
                <padding><Insets top="14" right="0" bottom="0" left="0"/></padding>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-panel">
                    <VBox styleClass="field-group">
                        <Label text="Section" styleClass="field-label"/>
                        <ComboBox fx:id="cmbSection" prefWidth="140"/>
                    </VBox>
                    <VBox styleClass="field-group">
                        <Label text="Status" styleClass="field-label"/>
                        <ComboBox fx:id="cmbStatus" prefWidth="140"/>
                    </VBox>
                    <VBox styleClass="field-group">
                        <Label text="From" styleClass="field-label"/>
                        <DatePicker fx:id="dpFrom" prefWidth="150"/>
                    </VBox>
                    <VBox styleClass="field-group">
                        <Label text="To" styleClass="field-label"/>
                        <DatePicker fx:id="dpTo" prefWidth="150"/>
                    </VBox>
                    <Button text="Filter" styleClass="btn-primary" onAction="#handleFilter"/>
                    <Button text="Reset" styleClass="btn-outline" onAction="#handleReset"/>
                </HBox>

                <VBox styleClass="table-shell" VBox.vgrow="ALWAYS">
                    <HBox styleClass="table-titlebar">
                        <VBox spacing="2">
                            <Label text="Worker Attendance Ledger" styleClass="table-title"/>
                            <Label text="Clock-in, clock-out and daily status by employee." styleClass="table-caption"/>
                        </VBox>
                    </HBox>
                    <TableView fx:id="attTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colEmpId"    text="ID"        prefWidth="70"/>
                            <TableColumn fx:id="colName"     text="Name"      prefWidth="220"/>
                            <TableColumn fx:id="colSection"  text="Section"   prefWidth="110"/>
                            <TableColumn fx:id="colDate"     text="Date"      prefWidth="120"/>
                            <TableColumn fx:id="colClockIn"  text="Clock In"  prefWidth="110"/>
                            <TableColumn fx:id="colClockOut" text="Clock Out" prefWidth="110"/>
                            <TableColumn fx:id="colStatus"   text="Status"    prefWidth="130"/>
                        </columns>
                        <placeholder><Label text="No records found. Use filters to search."/></placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>
        <Tab text="Supervisor Submissions">
            <VBox spacing="14">
                <padding><Insets top="14" right="0" bottom="0" left="0"/></padding>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-panel">
                    <Label text="Daily and monthly supervisor submissions appear here." styleClass="table-caption" wrapText="true"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh" styleClass="btn-primary" onAction="#loadSubmissions"/>
                </HBox>
                <VBox styleClass="table-shell" VBox.vgrow="ALWAYS">
                    <HBox styleClass="table-titlebar">
                        <VBox spacing="2">
                            <Label text="Submission Inbox" styleClass="table-title"/>
                            <Label text="Compiled attendance summaries sent by supervisors." styleClass="table-caption"/>
                        </VBox>
                    </HBox>
                    <TableView fx:id="tblSubmissions" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colSubId"      text="#"            prefWidth="60"/>
                            <TableColumn fx:id="colSubType"    text="Type"         prefWidth="180"/>
                            <TableColumn fx:id="colSubDetails" text="Details"      prefWidth="500"/>
                            <TableColumn fx:id="colSubTime"    text="Submitted At" prefWidth="180"/>
                        </columns>
                        <placeholder><Label text="No submissions yet. Supervisor has not sent any data."/></placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
