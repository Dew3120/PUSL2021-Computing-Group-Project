<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="18" styleClass="workspace"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group100.wms.ui.outbound.GinListController">
    <padding><Insets top="28" right="34" bottom="30" left="34"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="OUTBOUND" styleClass="module-kicker"/>
            <Label text="Goods Issue Notes" styleClass="module-title"/>
            <Label text="Warehouse issues, destinations, dispatch status and outbound traceability." styleClass="module-subtitle"/>
        </VBox>
        <Label text="FIFO stock movement" styleClass="module-chip"/>
    </HBox>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="TOTAL GINS" styleClass="metric-label"/>
            <Label fx:id="lblTotal" text="--" styleClass="metric-value"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="COMPLETED" styleClass="metric-label"/>
            <Label fx:id="lblCompleted" text="--" styleClass="metric-value-success"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="IN TRANSIT" styleClass="metric-label"/>
            <Label fx:id="lblTransit" text="--" styleClass="metric-value-info"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="CANCELLED" styleClass="metric-label"/>
            <Label fx:id="lblCancelled" text="--" styleClass="metric-value-danger"/>
        </VBox>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-panel">
        <VBox styleClass="field-group">
            <Label text="Status" styleClass="field-label"/>
            <ComboBox fx:id="cmbStatus" prefWidth="180"/>
        </VBox>
        <VBox styleClass="field-group">
            <Label text="Destination" styleClass="field-label"/>
            <ComboBox fx:id="cmbDest" prefWidth="250"/>
        </VBox>
        <Button text="Filter" onAction="#handleFilter" styleClass="btn-primary"/>
        <Button text="Reset" onAction="#handleReset" styleClass="btn-outline"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Export PDF" onAction="#handleExportPdf" styleClass="btn-primary"/>
        <Button text="Export Excel" onAction="#handleExportExcel" styleClass="btn-success"/>
    </HBox>

    <VBox styleClass="table-shell" VBox.vgrow="ALWAYS">
        <HBox styleClass="table-titlebar">
            <VBox spacing="2">
                <Label text="Dispatch Register" styleClass="table-title"/>
                <Label text="Source warehouse, destination and issue lifecycle." styleClass="table-caption"/>
            </VBox>
        </HBox>
        <TableView fx:id="ginTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colGinId" text="GIN #" prefWidth="70"/>
                <TableColumn fx:id="colWarehouse" text="Warehouse" prefWidth="170"/>
                <TableColumn fx:id="colDest" text="Destination" prefWidth="220"/>
                <TableColumn fx:id="colDestType" text="Type" prefWidth="130"/>
                <TableColumn fx:id="colDate" text="Issued Date" prefWidth="130"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
