<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="18" styleClass="workspace"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group100.wms.ui.inventory.InventoryListController">
    <padding><Insets top="28" right="34" bottom="30" left="34"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="INVENTORY" styleClass="module-kicker"/>
            <Label text="Inventory Control" styleClass="module-title"/>
            <Label text="Live item catalogue by SKU, category and warehouse location." styleClass="module-subtitle"/>
        </VBox>
        <Label text="800 item dataset" styleClass="module-chip"/>
    </HBox>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="TOTAL ITEMS" styleClass="metric-label"/>
            <Label fx:id="lblTotalItems" text="--" styleClass="metric-value"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="CATEGORIES" styleClass="metric-label"/>
            <Label fx:id="lblCategories" text="--" styleClass="metric-value-info"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="WAREHOUSE 1" styleClass="metric-label"/>
            <Label fx:id="lblWh1" text="--" styleClass="metric-value-success"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="WAREHOUSE 2" styleClass="metric-label"/>
            <Label fx:id="lblWh2" text="--" styleClass="metric-value-warning"/>
        </VBox>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-panel">
        <VBox styleClass="field-group">
            <Label text="Category" styleClass="field-label"/>
            <ComboBox fx:id="cmbCategory" prefWidth="210"/>
        </VBox>
        <VBox styleClass="field-group">
            <Label text="Search SKU or item" styleClass="field-label"/>
            <TextField fx:id="txtSearch" promptText="Search by name or SKU..." prefWidth="300"/>
        </VBox>
        <Button text="Filter" onAction="#handleFilter" styleClass="btn-primary"/>
        <Button text="Reset" onAction="#handleReset" styleClass="btn-outline"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Export PDF" onAction="#handleExportPdf" styleClass="btn-primary"/>
        <Button text="Export Excel" onAction="#handleExportExcel" styleClass="btn-success"/>
    </HBox>

    <VBox styleClass="table-shell" VBox.vgrow="ALWAYS">
        <HBox styleClass="table-titlebar">
            <VBox spacing="2">
                <Label text="Stock Ledger" styleClass="table-title"/>
                <Label text="SKU, category, colour, unit and warehouse mapping." styleClass="table-caption"/>
            </VBox>
        </HBox>
        <TableView fx:id="itemTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colSku" text="SKU" prefWidth="110"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="270"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="150"/>
                <TableColumn fx:id="colColour" text="Colour" prefWidth="100"/>
                <TableColumn fx:id="colUnit" text="Unit" prefWidth="70"/>
                <TableColumn fx:id="colWarehouse" text="Warehouse" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
