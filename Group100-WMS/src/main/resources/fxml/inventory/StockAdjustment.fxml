<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group100.wms.ui.inventory.StockAdjustmentController"
      spacing="14" maxWidth="500">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Stock Adjustment" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <Label text="Item"/>
    <ComboBox fx:id="itemComboBox" maxWidth="Infinity"/>

    <Label fx:id="currentStockLabel" text="Current Stock: —"
           style="-fx-text-fill: #2980b9; -fx-font-weight: bold;"/>

    <Label text="Adjustment Type"/>
    <ComboBox fx:id="adjustmentTypeCombo" maxWidth="Infinity"/>

    <Label text="Quantity"/>
    <TextField fx:id="quantityField" promptText="Enter quantity"/>

    <Label text="Cost Price (LKR)"/>
    <TextField fx:id="costPriceField" promptText="Enter cost price"/>

    <HBox spacing="8">
        <Button text="Apply" onAction="#handleApply"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button text="Clear" onAction="#handleClear"/>
    </HBox>

    <Label fx:id="statusLabel" text=""/>
</VBox>