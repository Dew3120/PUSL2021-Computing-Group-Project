<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group100.wms.ui.dashboard.AccountantDashboardController"
      spacing="18" styleClass="workspace">
    <padding><Insets top="28" right="34" bottom="30" left="34"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="FINANCE" styleClass="module-kicker"/>
            <Label text="Accountant Dashboard" styleClass="module-title"/>
            <Label text="Payroll and attendance records prepared for monthly salary processing." styleClass="module-subtitle"/>
        </VBox>
        <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-primary"/>
    </HBox>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS"><Label text="PAYROLL RECORDS" styleClass="metric-label"/><Label fx:id="payrollCountLabel" text="--" styleClass="metric-value-success"/></VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS"><Label text="ATTENDANCE RECORDS" styleClass="metric-label"/><Label fx:id="attendanceCountLabel" text="--" styleClass="metric-value-info"/></VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="dashboard-panel" spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Operational Coverage" styleClass="dashboard-panel-title"/>
            <Label text="Accountants can generate payroll, review salary records and export reports using attendance-backed calculations." styleClass="dashboard-panel-copy" wrapText="true"/>
        </VBox>
        <VBox styleClass="dashboard-panel" spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Portfolio Notes" styleClass="dashboard-panel-title"/>
            <Label text="This view is connected to the same MySQL-backed modules shown in inventory, inbound, outbound, attendance, payroll and forecasting." styleClass="dashboard-panel-copy" wrapText="true"/>
            <Label fx:id="statusLabel" text="" styleClass="status-text"/>
        </VBox>
    </HBox>
</VBox>
