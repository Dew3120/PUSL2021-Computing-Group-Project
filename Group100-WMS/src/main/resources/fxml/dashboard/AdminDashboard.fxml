<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group100.wms.ui.dashboard.AdminDashboardController"
      spacing="20">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    <Label text="Admin Dashboard" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
    <HBox spacing="16">
        <VBox styleClass="kpi-card" spacing="8" prefWidth="180">
            <Label text="Total Items" style="-fx-text-fill: #7f8c8d;"/>
            <Label fx:id="totalItemsLabel" text="—" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="8" prefWidth="180">
            <Label text="Total GRNs" style="-fx-text-fill: #7f8c8d;"/>
            <Label fx:id="totalGrnsLabel" text="—" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="8" prefWidth="180">
            <Label text="Total GINs" style="-fx-text-fill: #7f8c8d;"/>
            <Label fx:id="totalGinsLabel" text="—" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="8" prefWidth="180">
            <Label text="Payroll This Month" style="-fx-text-fill: #7f8c8d;"/>
            <Label fx:id="payrollThisMonthLabel" text="—" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
    <Button text="Refresh" onAction="#handleRefresh"/>
    <Label fx:id="statusLabel" text=""/>
</VBox>