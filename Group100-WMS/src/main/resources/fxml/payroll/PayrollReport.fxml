<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="18" styleClass="workspace"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group100.wms.ui.payroll.PayrollReportController">
    <padding><Insets top="28" right="34" bottom="30" left="34"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="module-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="PAYROLL" styleClass="module-kicker"/>
            <Label text="Payroll Report" styleClass="module-title"/>
            <Label text="Section-wise payroll records with net payout and employer contribution totals." styleClass="module-subtitle"/>
        </VBox>
        <Label text="Finance view" styleClass="module-chip"/>
    </HBox>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="TOTAL RECORDS" styleClass="metric-label"/>
            <Label fx:id="lblTotal" text="--" styleClass="metric-value"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="TOTAL NET PAYOUT" styleClass="metric-label"/>
            <Label fx:id="lblNetTotal" text="--" styleClass="metric-value-success"/>
        </VBox>
        <VBox styleClass="metric-card" spacing="5" HBox.hgrow="ALWAYS">
            <Label text="TOTAL EPF EMPLOYER" styleClass="metric-label"/>
            <Label fx:id="lblEpfTotal" text="--" styleClass="metric-value-info"/>
        </VBox>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-panel">
        <VBox styleClass="field-group">
            <Label text="Section" styleClass="field-label"/>
            <ComboBox fx:id="cmbSection" prefWidth="150"/>
        </VBox>
        <VBox styleClass="field-group">
            <Label text="Month" styleClass="field-label"/>
            <ComboBox fx:id="cmbMonth" prefWidth="120"/>
        </VBox>
        <VBox styleClass="field-group">
            <Label text="Year" styleClass="field-label"/>
            <ComboBox fx:id="cmbYear" prefWidth="120"/>
        </VBox>
        <Button text="Filter" onAction="#handleFilter" styleClass="btn-primary"/>
        <Button text="Reset" onAction="#handleReset" styleClass="btn-outline"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Export PDF" onAction="#handleExportPdf" styleClass="btn-primary"/>
        <Button text="Export Excel" onAction="#handleExportExcel" styleClass="btn-success"/>
    </HBox>

    <VBox styleClass="table-shell" VBox.vgrow="ALWAYS">
        <HBox styleClass="table-titlebar">
            <VBox spacing="2">
                <Label text="Payroll Ledger" styleClass="table-title"/>
                <Label text="Employee salary breakdown with EPF, ETF, deductions and net salary." styleClass="table-caption"/>
            </VBox>
        </HBox>
        <TableView fx:id="payrollTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colEmpId" text="Emp #" prefWidth="65"/>
                <TableColumn fx:id="colName" text="Employee Name" prefWidth="190"/>
                <TableColumn fx:id="colSection" text="Section" prefWidth="85"/>
                <TableColumn fx:id="colMonth" text="Month" prefWidth="70"/>
                <TableColumn fx:id="colYear" text="Year" prefWidth="65"/>
                <TableColumn fx:id="colBase" text="Base Salary" prefWidth="115"/>
                <TableColumn fx:id="colOT" text="Overtime" prefWidth="100"/>
                <TableColumn fx:id="colDeductions" text="Deductions" prefWidth="105"/>
                <TableColumn fx:id="colEpf" text="EPF Empl." prefWidth="100"/>
                <TableColumn fx:id="colEtf" text="ETF" prefWidth="85"/>
                <TableColumn fx:id="colNet" text="Net Salary" prefWidth="115"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
